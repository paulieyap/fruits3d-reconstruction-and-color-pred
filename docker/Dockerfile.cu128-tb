# Adds tensorboard (needed by Lightning's TensorBoardLogger) on top of an existing
# pcdiff:cu128 image, without recompiling MinkowskiEngine. A fresh build of
# Dockerfile.cu128 already includes it via requirements-cu128.txt.
#
#   docker build --network host -f docker/Dockerfile.cu128-tb -t pcdiff:cu128-r2 .
# (--network host: some hosts have no DNS inside the default build network)
ARG BASE=pcdiff:cu128
FROM ${BASE}
RUN pip install tensorboard==2.17.1
